# Google Sheets (service account with editor access to the sheet)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the key with literal \n sequences; they are converted at runtime
GOOGLE_PRIVATE_KEY=
NOMINATIONS_SHEET_ID=

# Resend
RESEND_API_KEY=
NOMINATIONS_ALERT_TO=hello@houseofevulv.com
# Sender must be on a domain verified in Resend
NOMINATIONS_FROM="House of Evulv <nominations@houseofevulv.com>"

# Package gate: false = Core, true = Full
FEATURE_FULL=false

# Optional: override "today" for testing date logic (YYYY-MM-DD, Africa/Lagos). Ignored in production.
DEBUG_TODAY=

# Set to true on the production domain at launch only; everything else stays out of search engines
ALLOW_INDEXING=false

